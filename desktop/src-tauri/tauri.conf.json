{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "com.zorrow.jarvis",
  "build": {
    "frontendDist": "../splash",
    "beforeDevCommand": "npm run sidecar:if-missing",
    "beforeBuildCommand": "npm run sidecar"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/jarvis-backend"],
    "shortDescription": "Jarvis voice assistant",
    "longDescription": "Jarvis, a local voice assistant: its panel in a native window, with a tray icon and a global hotkey.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
