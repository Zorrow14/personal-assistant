# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.

# Required: absolute path to the root of your Obsidian vault.
# Jarvis only ever writes inside <vault>/Jarvis/.
JARVIS_VAULT_PATH=C:/Users/you/Documents/ObsidianVault

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL (default INFO).
# WARNING keeps the chat free of per-call log lines.
JARVIS_LOG_LEVEL=INFO

# LLM. Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=
JARVIS_LLM_PROVIDER=gemini
JARVIS_LLM_MODEL=gemini-2.5-flash
JARVIS_LLM_MAX_TOKENS=1024
JARVIS_LLM_TEMPERATURE=0.7

# Safety cap on LLM round-trips per command.
JARVIS_AGENT_MAX_ITERATIONS=8
