# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.

# Required: absolute path to the root of your Obsidian vault.
# Jarvis only ever writes inside <vault>/Jarvis/.
JARVIS_VAULT_PATH=C:/Users/you/Documents/ObsidianVault

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL (default INFO).
# WARNING keeps the chat free of per-call log lines.
JARVIS_LOG_LEVEL=INFO

# LLM. Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=
JARVIS_LLM_PROVIDER=gemini
JARVIS_LLM_MODEL=gemini-2.5-flash
JARVIS_LLM_MAX_TOKENS=1024
JARVIS_LLM_TEMPERATURE=0.7

# Safety cap on LLM round-trips per command.
JARVIS_AGENT_MAX_ITERATIONS=8

# --- Voice (python -m jarvis.cli --voice) ---
# Audio devices: blank = system default. Find indices with --list-devices.
JARVIS_SAMPLE_RATE=16000
JARVIS_INPUT_DEVICE=
JARVIS_OUTPUT_DEVICE=

# Speech-to-text (faster-whisper; downloaded on first voice run).
# CPU: tiny.en / base.en / small.en with int8.  NVIDIA GPU: small.en+ with cuda + float16.
JARVIS_STT_MODEL=base.en
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8

# Text-to-speech: piper (neural, needs a voice file) or pyttsx3 (OS voice, no setup).
# Get a Piper voice: uv run python -m piper.download_voices en_US-lessac-medium --download-dir voices
JARVIS_TTS_PROVIDER=piper
JARVIS_TTS_VOICE=voices/en_US-lessac-medium.onnx

# --- Hands-free (python -m jarvis.cli --wake) ---
# openWakeWord pretrained model (bundled, no download) or a path to a custom .onnx.
JARVIS_WAKE_WORD_MODEL=hey_jarvis
# 0-1. Raise (e.g. 0.6-0.7) if it wakes by mistake; lower (0.3-0.4) if it misses you.
JARVIS_WAKE_WORD_THRESHOLD=0.5
# webrtcvad strictness 0-3: raise in noisy rooms so background noise isn't "speech".
JARVIS_VAD_AGGRESSIVENESS=2
# Silence that ends a command. Raise if it cuts you off mid-sentence.
JARVIS_VAD_SILENCE_MS=800
# 10, 20 or 30 only.
JARVIS_VAD_FRAME_MS=30
JARVIS_COMMAND_MAX_SECONDS=15
JARVIS_WAKE_CHIME=true

# --- Memory / retrieval (search_memory tool, --reindex) ---
# Local, on-device embeddings; note text never leaves the machine. The model
# (~70 MB) downloads once into .jarvis/fastembed on the first --reindex.
JARVIS_EMBEDDER_PROVIDER=local
JARVIS_EMBED_MODEL=BAAI/bge-small-en-v1.5
JARVIS_VECTOR_STORE=chroma
# Index location (relative to where you run Jarvis). .jarvis/ is git-ignored.
JARVIS_CHROMA_PATH=.jarvis/chroma
JARVIS_RAG_TOP_K=5
JARVIS_RAG_CHUNK_CHARS=1000
JARVIS_RAG_CHUNK_OVERLAP=150
# Index notes written during a turn right away, so they're searchable immediately.
JARVIS_AUTO_INDEX=true

# --- Tools (Phase 5) ---
# Whitelist by tool name (comma-separated); leave empty to enable every discovered tool.
# See them all with: uv run python -m jarvis.cli --list-tools
JARVIS_ENABLED_TOOLS=
# Ask y/N before tools with side effects (e.g. set_reminder). Strongly recommended: keep true.
JARVIS_CONFIRM_SIDE_EFFECTS=true
JARVIS_SEARCH_MAX_RESULTS=5
JARVIS_REMINDERS_PATH=.jarvis/reminders.json
# The only folder read_local_file may read under; empty = your vault folder.
JARVIS_FILE_SANDBOX_ROOT=

# --- Local web panel (python -m jarvis.cli --serve) ---
# Loopback only: 127.0.0.1, ::1 or localhost. Anything else (0.0.0.0, a LAN IP)
# is refused, because the panel can run tools and hears the mic.
JARVIS_UI_HOST=127.0.0.1
JARVIS_UI_PORT=8000
